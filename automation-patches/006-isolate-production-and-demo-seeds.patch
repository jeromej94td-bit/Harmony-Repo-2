         viewModelScope.launch {
             _isRefreshing.value = true
             com.example.data.SupabaseSync.fetchAndSync(getApplication())
             installDriveTotImages(getApplication())
             _isRefreshing.value = false
             showToast("Daten aktualisiert 🔄")
         }
     }
