diff --git a/.github/workflows/render-universal-intro-target.yml b/.github/workflows/render-universal-intro-target.yml
new file mode 100644
index 00000000..44e0a144
--- /dev/null
+++ b/.github/workflows/render-universal-intro-target.yml
@@ -0,0 +1,103 @@
+name: Render Universal intro from PR
+
+on:
+  pull_request_target:
+    types: [opened, synchronize, reopened]
+    branches:
+      - main
+    paths:
+      - 'tools/remotion/universal-intro/**'
+      - '.github/scripts/apply_universal_intro.py'
+      - '.github/workflows/render-universal-intro.yml'
+
+permissions:
+  contents: write
+
+concurrency:
+  group: universal-intro-target-render
+  cancel-in-progress: true
+
+jobs:
+  render-integrate-test:
+    if: ${{ github.event.pull_request.head.repo.full_name == github.repository && github.event.pull_request.head.ref == 'feature/universal-studios-intro' }}
+    runs-on: ubuntu-latest
+    timeout-minutes: 35
+    steps:
+      - name: Checkout trusted feature branch
+        uses: actions/checkout@v4
+        with:
+          ref: feature/universal-studios-intro
+          fetch-depth: 0
+
+      - name: Set up Node
+        uses: actions/setup-node@v4
+        with:
+          node-version: '22'
+
+      - name: Prepare branded panda asset
+        run: |
+          mkdir -p tools/remotion/universal-intro/public
+          cp app/src/main/res/drawable/panda_thinking_harmony.png tools/remotion/universal-intro/public/panda.png
+
+      - name: Install Remotion project
+        working-directory: tools/remotion/universal-intro
+        run: npm install --no-audit --no-fund
+
+      - name: Render Harmony intro
+        working-directory: tools/remotion/universal-intro
+        run: npm run render
+
+      - name: Apply Android intro integration
+        run: python .github/scripts/apply_universal_intro.py
+
+      - name: Bundle rendered intro as Android raw resource
+        run: |
+          mkdir -p app/src/main/res/raw
+          cp tools/remotion/universal-intro/out/universal_studios_intro.mp4 app/src/main/res/raw/universal_studios_intro.mp4
+
+      - name: Validate video dimensions
+        run: |
+          test "$(ffprobe -v error -select_streams v:0 -show_entries stream=width -of csv=p=0 app/src/main/res/raw/universal_studios_intro.mp4)" = "720"
+          test "$(ffprobe -v error -select_streams v:0 -show_entries stream=height -of csv=p=0 app/src/main/res/raw/universal_studios_intro.mp4)" = "1280"
+          ffprobe -v error -show_entries format=duration -of default=noprint_wrappers=1 app/src/main/res/raw/universal_studios_intro.mp4
+
+      - name: Create visual verification frames
+        run: |
+          mkdir -p tools/remotion/universal-intro/out/verification
+          ffmpeg -y -i app/src/main/res/raw/universal_studios_intro.mp4 -vf "fps=1,scale=180:-1,tile=4x2" -frames:v 1 tools/remotion/universal-intro/out/verification/contact-sheet.png
+          ffmpeg -y -ss 6.55 -i app/src/main/res/raw/universal_studios_intro.mp4 -frames:v 1 tools/remotion/universal-intro/out/verification/final-frame.png
+
+      - name: Set up JDK
+        uses: actions/setup-java@v5
+        with:
+          distribution: temurin
+          java-version: '21'
+
+      - name: Set up Gradle
+        uses: gradle/actions/setup-gradle@v4
+        with:
+          gradle-version: '9.3.1'
+
+      - name: Run focused tests
+        run: gradle :app:testDebugUnitTest --tests com.example.ui.UniversalStudiosIntroContractTest --stacktrace
+
+      - name: Compile app
+        run: gradle :app:compileDebugKotlin --stacktrace
+
+      - name: Upload verification artifact
+        uses: actions/upload-artifact@v4
+        with:
+          name: universal-studios-intro-verification
+          path: |
+            app/src/main/res/raw/universal_studios_intro.mp4
+            tools/remotion/universal-intro/out/verification/contact-sheet.png
+            tools/remotion/universal-intro/out/verification/final-frame.png
+          if-no-files-found: error
+
+      - name: Commit integration to feature branch
+        run: |
+          git config user.name "github-actions[bot]"
+          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
+          git add app/src/main/java/com/example/ui/screens/QuizRunnerScreen.kt app/src/main/res/raw/universal_studios_intro.mp4
+          git commit -m "feat: integrate rendered Universal intro"
+          git push origin HEAD:feature/universal-studios-intro
